{
  // =====================================================================
  //  KAIR Level-2 Paired Satellite Preprocessing Pipeline
  // =====================================================================
  //  Processes paired HR/LR satellite imagery through:
  //    1. Cloud / Shadow / Snow Masking
  //    2. Relative Normalization (histogram matching / mean-std transfer)
  //    3. Mask-Aware Absolute Normalization (percentile clipping)
  //    4. Spatial Co-registration (ECC)
  //    5. Degradation (optional - generates synthetic LR from HR)
  //    6. Mask-Aware Tiling & Filtering
  //
  //  Usage:
  //    python preprocessing_pipeline/complete_pipeline.py --config preprocessing_pipeline/config_l2.json
  // =====================================================================

  "task": "l2_paired_sr_preprocessing"      // task name (used for logging)

  // -----------------------------------------------------------------
  //  General settings
  // -----------------------------------------------------------------
  , "n_channels": 3                         // 1 for grayscale, 3 for RGB
  , "num_workers": 4                        // parallel workers for processing
  , "seed": null                            // random seed for reproducibility (null = random)
  , "supported_extensions": [".png", ".tif", ".tiff", ".jpg"]

  // -----------------------------------------------------------------
  //  Paths
  // -----------------------------------------------------------------
  , "input_hr_dir": "trainsets/satellite/HR"      // source directory of HR images
  , "input_lr_dir": "trainsets/satellite/LR"      // source directory of LR images (must match HR filenames)
  , "input_qa_dir": null                          // optional: directory of QA/SCL band images (matching filenames)
  , "output_hr_dir": "trainsets/satellite/HR_out" // where to save processed HR images / tiles
  , "output_lr_dir": "trainsets/satellite/LR_out" // where to save processed LR images / tiles
  , "save_format": "png"                          // "png" | "tif" | "jpg" (for full-image saves when tiling disabled)

  // =================================================================
  //  Step 1: Cloud / Shadow / Snow Masking
  // =================================================================
  //  Creates a binary mask (1 = valid, 0 = invalid) used by all
  //  downstream steps.
  //
  //  method "qa_band":
  //    Reads a QA / SCL band image from input_qa_dir.
  //    Sentinel-2 SCL classes:
  //      0: No Data,  1: Saturated/Defective
  //      2: Dark Area, 3: Cloud Shadows,  4: Vegetation
  //      5: Bare Soils, 6: Water, 7: Unclassified
  //      8: Cloud Medium Prob, 9: Cloud High Prob
  //      10: Thin Cirrus, 11: Snow / Ice
  //
  //  method "s2cloudless":
  //    Uses the s2cloudless ML detector (needs 10-band input).
  //    Requires: pip install s2cloudless
  // -----------------------------------------------------------------
  , "masking": {
    "enabled": true                                // enable/disable masking
    , "method": "qa_band"                          // "qa_band" | "s2cloudless"

    // ---- QA band options ----
    , "invalid_classes": [0, 1, 3, 8, 9, 10, 11]  // SCL class values to mask out

    // ---- s2cloudless options (only when method == "s2cloudless") ----
    , "s2_threshold": 0.4                          // cloud probability threshold
    , "s2_average_over": 4                         // smoothing window
    , "s2_dilation_size": 2                        // dilation pixels
    , "s2_auto_scale": true                        // auto-divide by 10000 for raw data
    , "s2_nodata": 0.0                             // value for masked pixels
  }

  // =================================================================
  //  Step 2: Relative Normalization
  // =================================================================
  //  Adjusts the radiometric distribution of one image to match
  //  the other.  Useful when HR and LR come from different sensors
  //  or acquisition dates.
  //
  //  method "histogram_match":
  //    Per-channel CDF transfer (robust, standard approach).
  //
  //  method "mean_std_transfer":
  //    Per-channel linear shift: (x - μ_src) / σ_src * σ_ref + μ_ref.
  //    Faster but assumes similar distributions.
  //
  //  method "none":
  //    Disabled (pass-through).
  // -----------------------------------------------------------------
  , "relative_normalization": {
    "enabled": false                               // enable/disable relative normalization
    , "method": "histogram_match"                  // "histogram_match" | "mean_std_transfer" | "none"
    , "direction": "lr_to_hr"                      // "lr_to_hr" (adjust LR to match HR) | "hr_to_lr"
    , "mask_aware": true                           // use masks when computing statistics
  }

  // =================================================================
  //  Step 3: Absolute Normalization (Percentile Clipping)
  // =================================================================
  //  Clips pixel values at low/high percentiles and stretches to
  //  [0, 255].  When mask_aware is true, percentiles are computed
  //  only from valid (unmasked) pixels.
  // -----------------------------------------------------------------
  , "normalization": {
    "enabled": true                                // enable/disable absolute normalization
    , "low_percentile": 2                          // lower percentile for clipping
    , "high_percentile": 98                        // upper percentile for clipping
    , "mask_aware": true                           // compute percentiles from valid pixels only
  }

  // =================================================================
  //  Step 4: Spatial Co-registration (ECC)
  // =================================================================
  //  Aligns LR to HR using OpenCV Enhanced Correlation Coefficient.
  //  Critical for paired super-resolution to ensure pixel-level
  //  correspondence.
  //
  //  warp_mode options:
  //    "translation"  – 2-DOF (x,y shift only; fastest, often sufficient)
  //    "euclidean"    – 3-DOF (shift + rotation)
  //    "affine"       – 6-DOF (shift + rotation + scale + shear)
  //    "homography"   – 8-DOF (full perspective; use with caution)
  // -----------------------------------------------------------------
  , "registration": {
    "enabled": true                                // enable/disable co-registration
    , "warp_mode": "translation"                   // "translation" | "euclidean" | "affine" | "homography"
    , "num_iters": 50                              // maximum ECC iterations
    , "eps": 1e-5                                  // convergence threshold
    , "gauss_filt_size": 5                         // Gaussian filter size (odd; 0 to disable)
    , "skip_on_failure": true                      // skip pair entirely if ECC fails
  }

  // =================================================================
  //  Step 5: Degradation (Optional)
  // =================================================================
  //  Applies realistic degradations to HR images to generate
  //  synthetic LR images. If enabled, replaces the input LR with
  //  the degraded version.
  //
  //  Available degradation types:
  //    - "satellite": Specialized for satellite imagery (MTF blur,
  //                   atmospheric haze, sensor noise)
  //    - "real_esrgan": General-purpose realistic degradation
  //    - "bsrgan": Blind super-resolution degradation
  //    - "bsrgan_plus": Enhanced BSRGAN with more options
  //
  //  NOTE: When degradation is enabled, you typically don't need
  //        input_lr_dir since LR is generated from HR.
  // -----------------------------------------------------------------
  , "degradation": {
    "enabled": false                               // enable/disable synthetic degradation
    , "type": "satellite"                          // "satellite" | "real_esrgan" | "bsrgan" | "bsrgan_plus"
    , "scale": 4                                   // downscaling factor (2, 3, 4, etc.)
    , "seed": 12345                                // random seed for reproducibility (null = random)

    // ---- Satellite degradation parameters ----
    , "satellite": {
      "blur_prob_1": 1.0                           // probability of first blur stage
      , "blur_type_1": "mtf"                       // "mtf" | "gaussian" | "anisotropic"
      , "resize_prob_1": 0.75                      // probability of first resize
      , "poisson_prob_1": 0.75                     // probability of poisson (shot) noise
      , "read_noise_prob_1": 0.55                  // probability of read noise
      , "haze_prob_1": 0.45                        // probability of atmospheric haze
      , "jpeg_prob_1": 0.12                        // probability of JPEG compression
      , "blur_prob_2": 0.92                        // second stage blur
      , "blur_type_2": "mtf"
      , "resize_prob_2": 0.70
      , "poisson_prob_2": 0.60
      , "read_noise_prob_2": 0.45
      , "haze_prob_2": 0.35
      , "jpeg_prob_2": 0.08
      , "final_jpeg_prob": 0.10                    // final JPEG compression
      , "resize_back_prob": 0.35                   // probability of resizing back to HR
      , "isp_prob": 0.08                           // probability of ISP artifacts
      , "noise_level1": 0.8                        // noise level lower bound
      , "noise_level2": 10.0                       // noise level upper bound
      , "mtf_sigma_optics_range": [0.8, 2.8]       // MTF optical blur range
      , "mtf_detector_width_range": [0.7, 1.8]     // MTF detector width range
      , "mtf_atm_sigma_range": [0.4, 1.8]          // MTF atmospheric blur range
    }

    // ---- Real-ESRGAN degradation parameters ----
    , "real_esrgan": {
      "blur_prob_1": 1.0
      , "resize_prob_1": 1.0
      , "gaussian_noise_prob_1": 0.5
      , "poisson_noise_prob_1": 0.1
      , "speckle_noise_prob_1": 0.1
      , "jpeg_prob_1": 0.9
      , "noise_level1_s1": 2
      , "noise_level2_s1": 25
      , "blur_prob_2": 0.8
      , "resize_prob_2": 1.0
      , "gaussian_noise_prob_2": 0.5
      , "poisson_noise_prob_2": 0.1
      , "speckle_noise_prob_2": 0.1
      , "jpeg_prob_2": 0.8
      , "noise_level1_s2": 2
      , "noise_level2_s2": 15
      , "final_jpeg_prob": 0.5
      , "resize_back_prob": 0.5
      , "isp_prob": 0.1
    }

    // ---- BSRGAN degradation parameters ----
    , "bsrgan": {
      "jpeg_prob": 0.9
      , "scale2_prob": 0.25
      , "isp_prob": 0.25
      , "noise_level1": 2
      , "noise_level2": 25
    }

    // ---- BSRGAN+ degradation parameters ----
    , "bsrgan_plus": {
      "shuffle_prob": 0.5
      , "use_sharp": false
      , "sharpening_weight": 0.5
      , "sharpening_radius": 50
      , "sharpening_threshold": 10
      , "poisson_prob": 0.1
      , "speckle_prob": 0.1
      , "isp_prob": 0.1
      , "noise_level1": 2
      , "noise_level2": 25
    }
  }

  // =================================================================
  //  Step 6: Mask-Aware Tiling & Filtering
  // =================================================================
  //  Slides a window over the processed images and saves only tiles
  //  where the fraction of invalid (masked) pixels does not exceed
  //  max_invalid_ratio.
  //
  //  Set step < crop_size for overlapping tiles.
  //  Set step == crop_size for non-overlapping tiles.
  //
  //  When disabled, saves full-resolution images instead.
  // -----------------------------------------------------------------
  , "tiling": {
    "enabled": true                                // enable/disable tiling
    , "crop_size": 256                             // tile size in pixels (HR space)
    , "step": 192                                  // stride (== crop_size means no overlap)
    , "max_invalid_ratio": 0.1                     // max fraction of masked pixels per tile (0.0–1.0)
    , "save_format": "png"                         // "png" | "tif" | "jpg" for tile output
  }
}

